# =============================================================================
# The Five Agents — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; `.env.example` is committed as the canonical template.
# When you add a new variable, add it to BOTH files so collaborators stay in sync.
# =============================================================================

# --- Claude / Anthropic ------------------------------------------------------
# API key for Claude — used by the CEO agent and any sub-agents that call the
# Anthropic API directly. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# --- OpenAI ------------------------------------------------------------------
# API key for OpenAI — used by the `gpt-image-gen` skill (image generation via
# the Images API). Yuval is the primary caller. Get one at
# https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# --- Add more as the project grows -------------------------------------------
# e.g. SUPABASE_URL=, SUPABASE_ANON_KEY=, etc.
